  <diagram id="3" name="03 입출력 규약과 연산 예시">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="인터페이스  |  4×4 PE · ACC 4세트 기준" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=30;align=left;verticalAlign=middle;spacing=15;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="70" as="geometry" />
        </mxCell>
        <mxCell id="in" value="입력: 로더 → 스파시티&#10;&#10;in_a 32bit / in_b 32bit&#10;in_rows 4bit / in_cols 4bit&#10;in_bank 2bit / in_first 1bit / in_last 1bit&#10;in_valid 입력 / in_ready 출력&#10;clk / rst 각 1bit&#10;&#10;매번 같은 K의 A 4개 + B 4개&#10;in_rows/in_cols는 유효 위치이며&#10;nonzero 마스크는 내부에서 별도 생성" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#a0aab6;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="530" height="350" as="geometry" />
        </mxCell>
        <mxCell id="out" value="연산 출력: 스파시티 → MAC&#10;&#10;out_a 128bit → op_a&#10;out_b 32bit → op_b&#10;out_b_tag 16bit → op_b_tag&#10;out_k_mask 8bit → column_k_position&#10;work_mask 16bit → work_mask&#10;out_rows/out_cols 각 4bit&#10;out_first/out_last 각 1bit&#10;out_valid 출력 / out_ready 입력" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0de;strokeColor=#bd7b20;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="630" y="130" width="530" height="350" as="geometry" />
        </mxCell>
        <mxCell id="obs" value="관찰 / 제어 정보 출력&#10;&#10;out_k 16bit: 그룹 시작 K&#10;out_bank 2bit: 타일 bank&#10;out_group_len 3bit: 유효 K 개수&#10;out_group_end 1bit: bank별 그룹 완료&#10;out_group_mask_a / b 각 16bit&#10;out_group_mode_a / b 각 8bit&#10;&#10;out_bank는 MAC의 bank 선택 입력이 아님&#10;MAC은 수락 순서와 first/last로 ACC 선택&#10;나머지 신호도 통합/관찰에 사용" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#a0aab6;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1220" y="130" width="530" height="350" as="geometry" />
        </mxCell>
        <mxCell id="layout" value="A 128bit 배치 — K-major&#10;&#10;[31:0]    = K0의 A 행0 / 행1 / 행2 / 행3&#10;[63:32]   = K1의 A 행0 / 행1 / 행2 / 행3&#10;[95:64]   = K2의 A 행0 / 행1 / 행2 / 행3&#10;[127:96]  = K3의 A 행0 / 행1 / 행2 / 행3&#10;&#10;정확한 byte: out_a[8*(4*k+r)+:8] = A[r,k]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3976c5;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=21;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="820" height="270" as="geometry" />
        </mxCell>
        <mxCell id="bits" value="서로 다른 마스크 / 인덱스의 배치&#10;&#10;out_k_mask[2*c+:2] : 열 c의 K 인덱스 (0~3)&#10;  열0=[1:0] · 열1=[3:2] · 열2=[5:4] · 열3=[7:6]&#10;work_mask[4*r+c] : 이번 round의 PE[r,c] 허용&#10;out_group_mask_a[4*r+k] : A 행 r의 원래 K 위치&#10;out_group_mask_b[4*c+k] : B 열 c의 원래 K 위치&#10;각 group_mode[2*i+:2] : 00 / 01 / 10 / 11" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0eaff;strokeColor=#8060b0;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=20;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="920" y="540" width="830" height="270" as="geometry" />
        </mxCell>
        <mxCell id="example" value="서로 다른 K를 한 round에 연산하는 예&#10;&#10;             K0   K1   K2   K3&#10;A 행0        2    3    4    5&#10;B 열0        0    7    0    2    → 2:4&#10;B 열1        6    0    8    0    → 2:4&#10;&#10;round0: 열0 K1 → 3×7 / 열1 K0 → 2×6&#10;round1: 열0 K3 → 5×2 / 열1 K2 → 4×8&#10;누산 결과: C[0,0]=31 / C[0,1]=44&#10;A는 두 round 모두 원래 K 순서로 전달" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3976c5;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=21;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="820" height="350" as="geometry" />
        </mxCell>
        <mxCell id="modes" value="모드별 동작과 주의할 해석&#10;&#10;00: nonzero 0개 → 해당 열 비활성&#10;01: nonzero 1개 → 그 K를 1 round에 발행&#10;10: nonzero 2개 → 그 K들을 2 round에 발행&#10;11: nonzero 3~4개 → 원래 K 순서로 dense 발행&#10;&#10;그룹의 round 수는 가장 긴 열에 맞춤&#10;먼저 끝난 열: B/tag/work_mask를 0으로 전달&#10;0인 첫/마지막 그룹은 제어 패킷 유지&#10;프루닝 없음: nonzero 값을 버리지 않음" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f6ee;strokeColor=#2b8a57;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=21;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="920" y="880" width="830" height="350" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="기준 RTL SHA-256: dbdb0d679d18671a129ace19…  |  첨부 코드의 실제 연결을 표현 · RTL 수정 없음 · NM_ENABLE 없음" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=2;fontColor=#162c40;fontFamily=Malgun Gothic;fontSize=17;align=left;verticalAlign=middle;spacing=15;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1280" width="1710" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>